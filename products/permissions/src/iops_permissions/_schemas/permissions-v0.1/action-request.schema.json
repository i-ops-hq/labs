{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iops-permissions:action-request:0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "action": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "filesystem",
            "process",
            "network",
            "api",
            "other"
          ]
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "resource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "directory",
                "process",
                "endpoint",
                "record",
                "other"
              ]
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "type",
            "identifier"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "operation",
        "resource"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "agent_id",
    "action"
  ],
  "additionalProperties": false
}
