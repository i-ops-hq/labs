{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iops-labs:contracts:evidence-result:0.1.0",
  "title": "evidence-result",
  "description": "Experimental foundation contract. Validation is not authorization or execution.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "extensions": {
      "type": "object",
      "description": "Non-semantic metadata only; MUST NOT affect execution or verdicts."
    },
    "result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "unsupported",
        "skipped",
        "error"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "observed",
        "reference",
        "mock"
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "expectation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "inconclusive",
              "unsupported",
              "skipped",
              "error"
            ]
          },
          "verifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "assertion_id",
          "expectation",
          "outcome",
          "verifier",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "observation_scope": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "not_visible": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "visible",
        "not_visible"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "state_snapshot",
              "event_log",
              "report"
            ]
          },
          "locator": {
            "type": "string",
            "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "redaction": {
            "type": "string",
            "enum": [
              "redacted",
              "synthetic"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "type",
          "locator",
          "redaction"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "runner": {
      "type": "object",
      "properties": {
        "runner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "runner_id",
        "version"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "adapter_id",
        "version"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "scenario_id",
    "run_id",
    "started_at",
    "finished_at",
    "verdict",
    "provenance",
    "assertions",
    "observation_scope",
    "artifacts",
    "runner",
    "adapter",
    "limitations",
    "summary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "passed"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "assertions": {
            "minItems": 1,
            "items": {
              "properties": {
                "outcome": {
                  "const": "passed"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
