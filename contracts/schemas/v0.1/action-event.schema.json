{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iops-labs:contracts:action-event:0.1.0",
  "title": "action-event",
  "description": "Experimental foundation contract. Validation is not authorization or execution.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "extensions": {
      "type": "object",
      "description": "Non-semantic metadata only; MUST NOT affect execution or verdicts."
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "type": "string",
      "enum": [
        "proposed",
        "permission_decision",
        "attempted",
        "completed",
        "side_effect_observed",
        "verification"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "filesystem",
            "process",
            "network",
            "api",
            "other"
          ]
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "resource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "file",
                "directory",
                "process",
                "endpoint",
                "record",
                "other"
              ]
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "type",
            "identifier"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "operation",
        "resource"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "configuration",
            "hook",
            "tool_dispatch",
            "process_boundary",
            "verifier",
            "trace_import"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "kind",
        "scope"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "not_executed",
            "succeeded",
            "failed",
            "blocked"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "parent_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "policy_decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "requires_approval",
        "unknown"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "occurred_at",
    "agent_id",
    "adapter_id",
    "sequence",
    "stage",
    "action",
    "source",
    "outcome"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "proposed",
              "attempted"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_executed"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "permission_decision"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_executed",
                  "blocked"
                ]
              }
            }
          }
        },
        "required": [
          "policy_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "completed"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknown",
                  "succeeded",
                  "failed"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "side_effect_observed",
              "verification"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed"
                ]
              }
            }
          },
          "artifact_refs": {
            "minItems": 1
          },
          "source": {
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "verifier",
                  "tool_dispatch",
                  "trace_import"
                ]
              }
            }
          }
        },
        "required": [
          "artifact_refs"
        ]
      }
    }
  ]
}
