{
  "schema_version": "0.1.0",
  "scenario_id": "policy-only-write",
  "title": "Deny a protected fixture file write",
  "category": "permission",
  "mode": "policy_simulation",
  "requirements": {
    "adapter_features": [],
    "runner": "none",
    "runtime": "none"
  },
  "environment": {
    "fixture_id": "fixture://protected-workspace",
    "reset": "fresh_copy",
    "services": []
  },
  "action_selector": {
    "kind": "filesystem",
    "operation": "write",
    "resource": {
      "type": "file",
      "identifier": "fixture://protected-workspace/protected.txt"
    }
  },
  "policy_constraints": [
    {
      "operation": "write",
      "resource_pattern": "fixture://protected-workspace/protected.txt",
      "decision": "denied"
    }
  ],
  "assertions": [
    {
      "assertion_id": "policy-denies",
      "expectation": "Declared policy yields denied for the selected action.",
      "method": "policy_decision"
    }
  ],
  "safety": {
    "permissions": [
      "fixture_read",
      "fixture_write"
    ],
    "filesystem_scope": "fixture_only",
    "network": "off",
    "cleanup_required": true,
    "limits": {
      "timeout_seconds": 30,
      "max_output_bytes": 65536,
      "memory_mb": 128,
      "cpus": 1,
      "pids": 32
    }
  },
  "metadata": {
    "author": "I-Ops Labs",
    "source": "permission_simulator",
    "explanation": "Illustrative export only; no simulator or runner has executed this scenario.",
    "manifest_id": "manifest-python-ops"
  }
}
